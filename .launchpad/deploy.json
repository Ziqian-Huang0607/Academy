{
  "root": ".",
  "mode": "production",
  "runtime": "generated-container",
  "packageManager": "npm",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "spaFallback": true,
  "healthPath": "/",
  "ignore": [
    "content",
    "build",
    "output",
    "sources",
    "dist",
    "node_modules",
    ".launchpad-data",
    "work"
  ],
  "startCommand": "npm start -- --port $PORT"
}
